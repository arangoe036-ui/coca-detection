# --- Project data & outputs (large files + data sensitivity) ---
# Anchored to repo root so these DON'T also match ui/data/ (git can't re-include
# files inside an ignored dir, which would hide the small UI results below).
/data/
/outputs/
# ui/data: ignore everything EXCEPT the small UI-needed vector/tabular results
ui/data/*
!ui/data/*.geojson
!ui/data/*.csv
*.tif
*.tiff
*.ckpt
*.pt
*.pth
checkpoints/
# but DO keep the small downsampled COG(s) the map overlay needs (after *.tif so this wins)
!ui/data/*_cog.tif

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env
.ipynb_checkpoints/

# --- Earth Engine / creds ---
*.json.key
.config/earthengine/
service-account*.json

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
